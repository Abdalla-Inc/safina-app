# Keep secrets server-side. Never prefix these with VITE_.
SAFINA_AUTH_MODE=sandbox
SAFINA_APP_ORIGIN=http://127.0.0.1:5178
# Live mode: supabase. Supply a stable random secret of at least 32 bytes.
# SAFINA_SERVER_KEY=
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# Registration is invitation-only unless explicitly set to 1.
# SAFINA_OPEN_REGISTRATION=0

# Private course-media signing only; never expose this in browser code.
# SUPABASE_STORAGE_SERVICE_KEY=

# Promote this owner only after verified email/password or Google sign-in.
SAFINA_SUPER_ADMIN_EMAIL=gubaraabdalla@gmail.com
