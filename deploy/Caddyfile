{
    admin off
    auto_https off
}
:{$PORT:8080} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    handle /api/v1/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle {
        root * /app/frontend
        try_files {path} /index.html
        file_server
    }
}
